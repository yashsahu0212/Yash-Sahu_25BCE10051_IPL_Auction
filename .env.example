# ==============================================================================
# HAMMER IPL AUCTION PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and replace the values with your actual credentials.
# Note: VITE_ prefixes are optional/legacy; standard SUPABASE_* keys are auto-detected.

# 1. SUPABASE PROJECT URL & KEYS
# Found in Supabase Dashboard -> Project Settings -> API (or top "Connect" button)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. SERVER-ONLY SECRETS - NEVER EXPOSE IN BROWSER CODE
# Grants authoritative backend access; kept safe on server only
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-dashboard-api-settings
SESSION_SECRET=hammer-authoritative-auction-secret-2026

# 3. DIRECT POSTGRESQL ACCESS (Optional)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# 4. SERVER RUNTIME SETTINGS
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=*
