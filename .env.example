# =====================================================================
# HAMMER — REALTIME CRICKET AUCTION ENGINE
# Supabase Environment Configuration Reference
# =====================================================================

# ---------------------------------------------------------------------
# PUBLIC CLIENT CONFIGURATION (SAFE TO EXPOSE IN BROWSER)
# ---------------------------------------------------------------------
# Your Supabase Project URL (found in Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Publishable / Anon API Key (Safe for client browsers with RLS enabled)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------
# SERVER-ONLY / PRIVILEGED SECRETS (NEVER EXPOSE IN BROWSER CODE)
# ---------------------------------------------------------------------
# Supabase Service Role Key (Bypasses RLS - only use in server migrations or admin scripts)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Database Connection String (Direct connection for migrations)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# Optional: Local Server Port (for local static file serving or development)
PORT=3000
